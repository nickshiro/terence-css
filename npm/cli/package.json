{
  "name": "terence-css",
  "version": "0.1.4",
  "description": "Portable native CSS formatter written in Zig",
  "type": "module",
  "license": "MIT",
  "bin": {
    "terence-css": "bin/terence-css.js"
  },
  "files": [
    "bin/terence-css.js",
    "lib/platform.js"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{js,mjs,json,md}\" \"../scripts/**/*.{js,mjs,json,md}\" \"../native/**/*.{json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\" \"../scripts/**/*.{js,mjs,json,md}\" \"../native/**/*.{json,md}\"",
    "prepack": "npm run format:check",
    "test": "npm run format:check && node ../scripts/build-native.mjs --host && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickshiro/terence-css.git",
    "directory": "npm/cli"
  },
  "keywords": [
    "css",
    "formatter",
    "cli",
    "zig",
    "native"
  ],
  "optionalDependencies": {
    "@terence-css/cli-darwin-arm64": "0.1.4",
    "@terence-css/cli-darwin-x64": "0.1.4",
    "@terence-css/cli-linux-arm64": "0.1.4",
    "@terence-css/cli-linux-x64": "0.1.4",
    "@terence-css/cli-win32-x64": "0.1.4"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
